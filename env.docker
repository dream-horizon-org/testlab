# Docker Environment Configuration Template
# Copy this file to .env for local development
# Usage: cp env.docker .env

# ===========================
# Application Settings
# ===========================
ENV=docker
TEAM_SUFFIX=
PRIVATE_HOSTED_ZONE=

# ===========================
# PostgreSQL Configuration
# ===========================
POSTGRES_HOST=testlab-postgres
POSTGRES_PORT=5432
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DATABASE=experiment

# ===========================
# Application Server
# ===========================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ===========================
# Aerospike Configuration
# ===========================
AEROSPIKE_HOST=testlab-aerospike
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=test
AEROSPIKE_EVENT_LOOP_SIZE=16
AEROSPIKE_MAX_COMMANDS_IN_PROCESS=40
AEROSPIKE_MAX_CONNECTIONS_PER_NODE=700

# ===========================
# JVM Configuration
# ===========================
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

